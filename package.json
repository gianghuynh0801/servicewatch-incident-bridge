{
  "name": "servicewatch-incident-bridge",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node --experimental-sqlite server.js",
    "dev": "node --experimental-sqlite server.js",
    "worker": "node --experimental-sqlite -e \"require('./engine').runProbeCycle().then(() => console.log('Probe worker executed successfully'))\"",
    "heartbeat:check": "node --experimental-sqlite -e \"require('./engine').evaluateHeartbeats(); console.log('Heartbeat audit completed')\"",
    "cron": "node --experimental-sqlite server.js",
    "test": "node --experimental-sqlite test-workflow.js"
  },
  "keywords": [
    "sre",
    "incident-bridge",
    "observability",
    "dns-monitor",
    "ai-copilot",
    "self-healing"
  ],
  "author": "ServiceWatch Team",
  "license": "MIT",
  "description": "Nền tảng tự động điều phối & cầu nối xử lý sự cố hạ tầng số đa tầng",
  "dependencies": {
    "express": "^5.2.1"
  }
}
